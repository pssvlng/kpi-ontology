@prefix inst: <https://data.datev.de/kpi/instance/generated/> .
@prefix kpi: <https://data.datev.de/kpi/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

inst:kpi1 a kpi:KeyPerformanceIndicator ;
    kpi:aggregationPropertyURI "http://datev.de/dalo/ontology#current_gross_payment"^^xsd:anyURI ;
    kpi:dataSourceURI "http://localhost:8080/graph/bulk1"^^xsd:anyURI ;
    kpi:hasAggregationOperator kpi:Average ;
    kpi:hasAggregationResult inst:result-01,
        inst:result-02,
        inst:result-03,
        inst:result-04,
        inst:result-05 ;
    kpi:hasGranularityDimension inst:dim-gender-description,
        inst:dim-highest-level-of-education-description ;
    kpi:kpiLabel "AVG of Current Gross Payment by gender Description and Highest Level of Education Description"@de,
        "AVG of Current Gross Payment by gender Description and Highest Level of Education Description"@en ;
    kpi:referenceOntologyURI "https://brickschema.org/schema/Brick#"^^xsd:anyURI .

inst:dv-01-geschlechtdescription a kpi:DimensionValue ;
    kpi:dimensionValueLiteral "männlich" ;
    kpi:forDimension inst:dim-gender-description .

inst:dv-01-highestlevelofeducationdescription a kpi:DimensionValue ;
    kpi:dimensionValueLiteral "Haupt-/Volksschulabschluss" ;
    kpi:forDimension inst:dim-highest-level-of-education-description .

